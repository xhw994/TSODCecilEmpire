  <Dependency type="Dlc" title="Expansion: Rise and Fall" id="1B28771A-C749-434B-9053-D1380C553DE9" />
  <Dependency type="Dlc" title="Vietnam and Kublai Khan Pack" id="A3F42CD4-6C3E-4F5A-BC81-BE29E0C0B87C" />
  <Dependency type="Dlc" title="Ethiopia Pack" id="1B394FE9-23DC-4868-8F0A-5220CB8FB427" />
</Associations>]]></AssociationData>
