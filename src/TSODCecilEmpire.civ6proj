" criteria="TsoDCE_Expansion2"><Properties><Context>InGame</Context><LoadOrder>100</LoadOrder></Properties><File>UI/TsoDCE_AmberRetire.xml</File></AddUserInterfaces></InGameActions>]]></InGameActionData>
